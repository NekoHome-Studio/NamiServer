# ============================================================================
# Nami — self-hosted AI agent server carrier
#
# Copy to `.env` and edit:   cp .env.example .env
#
# Every variable the server understands is listed here, with the real default
# shown as its value. Any variable left unset (or set to an empty string) falls
# back to exactly that default, so this file with no edits boots a fully
# working, fully offline server.
#
# Env vars beat `.env`, and `.env` is read from the process working directory.
# ============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Interface to bind. Use 0.0.0.0 inside a container so the published port works.
NAMI_HOST=127.0.0.1
# TCP port for both the HTTP API and the WebSocket upgrade.
NAMI_PORT=8787
# CORS allow-origin for browser clients; "*" allows any origin.
NAMI_CORS_ORIGIN=*
# Hard cap on a request body, in bytes (larger bodies get HTTP 413).
NAMI_MAX_BODY_BYTES=1048576
# Watch .env and rebuild the server in place when it changes. The console's
# config editor writes .env, so with this on (the default) saved changes apply
# within about a second. Set to false to require the console's restart button.
NAMI_HOT_RELOAD=true
# Per-request timeout budget, in milliseconds.
NAMI_REQUEST_TIMEOUT_MS=120000
# How long in-flight work may finish during SIGTERM/SIGINT shutdown, in ms.
NAMI_SHUTDOWN_GRACE_MS=8000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Accepted bearer tokens for /v1/*, comma-separated for multiple keys.
# LEAVE EMPTY to have the server generate a random key at boot and log it
# prominently (readable via `docker logs nami-server`).
# Example: NAMI_API_KEYS=nami_change_me_please,nami_second_key
NAMI_API_KEYS=
# Token required by /admin/api/*, sent as "X-Admin-Token: <token>".
# When unset, any valid API key is accepted for admin routes instead.
NAMI_ADMIN_TOKEN=

# --- Console accounts (WebUI login) ----------------------------------------
# Accounts live in the database; API keys keep working for /v1/* regardless.
# These two are read ONLY while the users table is empty (first boot), so
# changing them later cannot create or rewrite an account.
NAMI_ADMIN_USER=admin
# Initial password for that first account. Leave EMPTY to have the server
# generate a strong one and print it exactly once at boot.
# At least 10 characters; a password that fails the policy is replaced with a
# generated one (and the reason logged) rather than blocking startup.
NAMI_ADMIN_PASSWORD=
# How long a console login lasts, in hours.
NAMI_SESSION_TTL_HOURS=168
# Session cookie name, and its Secure attribute: auto | always | never.
# "auto" marks it Secure when the request looks like HTTPS (see below).
NAMI_SESSION_COOKIE=nami_session
NAMI_COOKIE_SECURE=auto
# Trust X-Forwarded-Proto / X-Forwarded-For. Enable ONLY behind your own
# reverse proxy: a client able to set those headers can otherwise spoof both.
NAMI_TRUST_PROXY=false
# Failed console logins before a lockout, counted per username AND per address.
# Set NAMI_LOGIN_LOCKOUT_SECONDS=0 to disable locking entirely.
NAMI_LOGIN_MAX_ATTEMPTS=5
NAMI_LOGIN_LOCKOUT_SECONDS=300
# Failures older than this window start a fresh count, in seconds.
NAMI_LOGIN_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# One of: debug | info | warn | error | silent
NAMI_LOG_LEVEL=info
# "pretty" for human-readable lines, "json" for one JSON object per line.
NAMI_LOG_FORMAT=pretty
# Lowest level buffered for the WebUI log page (debug | info | warn | error).
# Deliberately independent of NAMI_LOG_LEVEL: setting the console to "error" to
# quiet it should not leave the WebUI log page permanently empty.
NAMI_LOG_CAPTURE_LEVEL=info
# Ring-buffer size behind the WebUI log page (minimum 50). The buffer is
# in-memory only and is not persisted across restarts.
NAMI_LOG_BUFFER_SIZE=1000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database file. Relative paths resolve against the working directory.
# In Docker this must stay inside the mounted volume: /app/data/nami.sqlite
NAMI_DB_PATH=data/nami.sqlite
# The .env file this process loads, and the one the WebUI config editor writes.
# Overriding it lets two instances on one host keep separate environments.
# It is deliberately NOT editable from the WebUI — offering to rewrite the path
# of the file you are editing is a trap.
NAMI_ENV_PATH=.env

# ---------------------------------------------------------------------------
# Agent loop
# ---------------------------------------------------------------------------
# Default system prompt (quoted). Overridden per request by `system`.
# NAMI_SYSTEM_PROMPT="You are Nami, a concise and reliable assistant running inside the Nami agent server. Use the available tools whenever they let you answer more accurately. When you call a tool, wait for its result before answering."
# Maximum tool-calling rounds per run before the loop stops and says so.
NAMI_MAX_TOOL_ROUNDS=6
# Wall-clock limit for a single tool invocation, in milliseconds.
NAMI_TOOL_TIMEOUT_MS=15000
# Tool results handed back to the model are truncated beyond this many bytes.
NAMI_MAX_TOOL_RESULT_BYTES=32768
# How many stored messages are replayed into the model context.
NAMI_MAX_HISTORY_MESSAGES=40
# Sampling temperature used when a request does not specify one.
NAMI_TEMPERATURE=0.7
# Max completion tokens used when a request does not specify one.
NAMI_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "mock" (default) runs fully offline with no API key; "ollama" uses the native
# Ollama API (recommended for a local model); "openai" talks to any
# OpenAI-compatible /chat/completions endpoint (OpenAI, DeepSeek, Groq, vLLM,
# LM Studio, ...).
#
# Tip: run `npm run ollama -- --write` to detect Ollama and fill this in for you.
NAMI_LLM_PROVIDER=mock
# Base URL of the OpenAI-compatible API. Trailing slashes are stripped.
# Ignored when NAMI_LLM_PROVIDER=ollama, which derives it from NAMI_OLLAMA_URL.
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama (shim): http://127.0.0.1:11434/v1
NAMI_LLM_BASE_URL=https://api.openai.com/v1
# Upstream API key. Not needed for provider=mock or provider=ollama.
NAMI_LLM_API_KEY=
# Model id. Defaults depend on the provider: mock -> nami-mock-1,
# openai -> gpt-4o-mini, ollama -> empty, meaning "discover at boot and use the
# first installed model".
NAMI_LLM_MODEL=nami-mock-1
# Upstream request timeout, in milliseconds.
NAMI_LLM_TIMEOUT_MS=120000
# Per-chunk delay of the offline mock provider, in milliseconds. It only makes
# the mock stream look realistic; 0 makes it as fast as possible.
NAMI_MOCK_DELAY_MS=8
# Extra headers sent on every upstream request, comma-separated key=value pairs.
# Example: NAMI_LLM_HEADERS=X-Title=nami,HTTP-Referer=https://example.com
NAMI_LLM_HEADERS=

# ---------------------------------------------------------------------------
# Ollama (only used when NAMI_LLM_PROVIDER=ollama)
# ---------------------------------------------------------------------------
# Native API base, WITHOUT the /v1 suffix. Setting this variable is enough to
# select the Ollama adapter even if NAMI_LLM_PROVIDER is left unset.
NAMI_OLLAMA_URL=http://127.0.0.1:11434
# How long Ollama keeps the model loaded after a request. Use "0" to unload
# immediately, or "-1" to keep it resident forever.
NAMI_OLLAMA_KEEP_ALIVE=5m
# Context window (num_ctx). 0 leaves Ollama's own default in place, which is
# usually 4096. Raising it costs memory.
NAMI_OLLAMA_NUM_CTX=0
# Timeout for the boot-time version/tags probe, in milliseconds.
NAMI_OLLAMA_PROBE_TIMEOUT_MS=4000

# ---------------------------------------------------------------------------
# Model exposure (hosting Nami as a shared OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Allow clients to choose the model per request, like OpenAI does. When false,
# every request is pinned to NAMI_LLM_MODEL.
NAMI_ALLOW_CLIENT_MODEL=true
# Allowlist of CLIENT-FACING model names to expose. Empty exposes everything
# discovered. Names here are what clients may pass as "model".
# Example: NAMI_MODELS_EXPOSE=gpt-4o-mini,qwen2.5:7b
NAMI_MODELS_EXPOSE=
# Rewrite client-facing names onto real upstream models, so a tool hardcoding
# "gpt-4o-mini" can be pointed at a local model. Comma-separated name=target.
# Example: NAMI_MODEL_ALIASES=gpt-4o-mini=qwen2.5:7b,claude-3-5-sonnet=llama3.1:8b
NAMI_MODEL_ALIASES=
# How long a model-discovery result stays fresh, in milliseconds.
NAMI_MODELS_CACHE_TTL_MS=30000

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------
# Outbound HTTP tool (http_get). OFF by default; enabling it ALSO requires a
# non-empty host allowlist below, otherwise the tool stays disabled.
NAMI_TOOL_HTTP_ENABLED=false
# Comma-separated allowlist. Supports exact hosts ("api.github.com",
# "api.github.com:8443"), subdomain wildcards ("*.wikipedia.org") and "*" for
# everything. Re-checked on every redirect hop.
NAMI_TOOL_HTTP_ALLOW_HOSTS=
# Per-request timeout for http_get, in milliseconds.
NAMI_TOOL_HTTP_TIMEOUT_MS=10000
# Maximum response bytes read by http_get before truncating.
NAMI_TOOL_HTTP_MAX_BYTES=262144
# Filesystem tools (fs_read / fs_list). OFF by default; enabling it ALSO
# requires a non-empty roots list below.
NAMI_TOOL_FS_ENABLED=false
# Comma-separated directories the filesystem tools may touch. Relative paths
# resolve against the working directory. Access is re-verified after realpath,
# so symlinks cannot escape these roots.
# Example: NAMI_TOOL_FS_ALLOW_ROOTS=/app/data,/srv/documents
NAMI_TOOL_FS_ALLOW_ROOTS=
# Maximum bytes returned by fs_read.
NAMI_TOOL_FS_MAX_BYTES=262144
# Session-scoped key/value memory tools (memory_write/read/list/delete).
NAMI_TOOL_MEMORY_ENABLED=true

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Per-API-key token-bucket limiter; HTTP 429 with Retry-After when exhausted.
NAMI_RATE_LIMIT_ENABLED=true
# Bucket capacity, i.e. the maximum burst of requests.
NAMI_RATE_LIMIT_BURST=60
# Tokens replenished per second (sustained request rate).
NAMI_RATE_LIMIT_PER_SECOND=1

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------
# Path of the WebSocket endpoint (HTTP upgrade to the same port).
NAMI_WS_PATH=/ws
# Largest accepted frame payload, in bytes; bigger frames close the socket.
NAMI_WS_MAX_PAYLOAD_BYTES=1048576
# Server ping interval, in milliseconds.
NAMI_WS_HEARTBEAT_MS=30000
# Concurrent connections allowed per API key.
NAMI_WS_MAX_CONNECTIONS_PER_KEY=8

# ---------------------------------------------------------------------------
# OneBot v11 connector (QQ, via SnowLuma / NapCat / LLOneBot / Lagrange)
# ---------------------------------------------------------------------------
# Master switch. Both directions default to OFF: an inbound endpoint that
# triggers model calls, and an agent that can send QQ messages, should each be
# turned on deliberately.
NAMI_ONEBOT_ENABLED=false
# OneBot v11 HTTP API base, WITHOUT any path suffix.
# SnowLuma's default is http://127.0.0.1:3000 ; NapCat/LLOneBot commonly use 3000 too.
# In Docker, reaching the host is usually http://host.docker.internal:3000 .
NAMI_ONEBOT_URL=http://127.0.0.1:3000
# OneBot access_token, sent as "Authorization: Bearer". Leave empty if your
# implementation does not require one.
NAMI_ONEBOT_ACCESS_TOKEN=
# Shared secret required on inbound reports (POST /onebot/event). Use the SAME
# value as the report secret configured in SnowLuma. While this is empty the
# endpoint refuses every report, because an open report endpoint would let anyone
# burn your model budget.
NAMI_ONEBOT_EVENT_TOKEN=
# Timeout for OneBot API calls, in milliseconds.
NAMI_ONEBOT_TIMEOUT_MS=10000

# --- inbound: answer QQ messages -------------------------------------------
# Serve POST /onebot/event.
NAMI_ONEBOT_INBOUND_ENABLED=true
# When to answer: "mention" (only when @-ed; private chats always count as
# directed at the bot), "prefix" (message starts with NAMI_ONEBOT_PREFIX),
# "all" (every message - expensive and noisy), or "none".
NAMI_ONEBOT_TRIGGER=mention
# Trigger prefix used when NAMI_ONEBOT_TRIGGER=prefix.
NAMI_ONEBOT_PREFIX=/ai
# Groups allowed to trigger the bot, comma-separated. Empty allows every group.
# Example: NAMI_ONEBOT_ALLOW_GROUPS=123456789,987654321
NAMI_ONEBOT_ALLOW_GROUPS=
# Users allowed to trigger the bot, comma-separated. Empty allows every user.
NAMI_ONEBOT_ALLOW_USERS=
# Nami session ids become <prefix>-group-<group_id> / <prefix>-user-<user_id>,
# so each QQ conversation keeps its own history in SQLite.
NAMI_ONEBOT_SESSION_PREFIX=qq
# System prompt used for QQ replies. QQ renders no Markdown at all, so asking
# for plain prose up front beats stripping syntax afterwards.
NAMI_ONEBOT_SYSTEM_PROMPT=
# Longest single QQ message; longer answers are split at this many characters.
NAMI_ONEBOT_MAX_REPLY_CHARS=1500
# Strip Markdown before sending (QQ would show ** and ``` literally).
NAMI_ONEBOT_STRIP_MARKDOWN=true
# Cap on simultaneous QQ-triggered runs. Extra events for the same conversation
# are dropped rather than queued, so a burst cannot pile up model calls.
NAMI_ONEBOT_MAX_CONCURRENT=2

# --- outbound: let the agent send QQ messages -------------------------------
# Enables the onebot_send_* tools. They ALSO require a non-empty allowlist below;
# with both lists empty the tools stay registered but disabled.
NAMI_ONEBOT_TOOL_ENABLED=false
# Groups the agent may send to proactively. Empty disables group sending.
NAMI_ONEBOT_TOOL_ALLOW_GROUPS=
# Users the agent may private-message proactively. Empty disables private sending.
NAMI_ONEBOT_TOOL_ALLOW_USERS=
